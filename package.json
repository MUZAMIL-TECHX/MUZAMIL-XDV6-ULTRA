{
"name": "muzamil-xd",
"version": "1.0.1",
"description": "MUZAMIL-XD WhatsApp Bot powered by RedxBaileys",
"main": "index.js",
"type": "commonjs",
"scripts": {
"start": "node index.js",
"dev": "node --watch index.js",
"start:optimized": "node --max-old-space-size=512 --optimize-for-size --gc-interval=100 index.js",
"start:clean": "npm run cleanup && npm run start:optimized",
"start:fresh": "npm run reset-session && npm start",
"cleanup": "node cleanup.js",
"reset-session": "node reset-session.js",
"install:panel": "npm install --legacy-peer-deps",
"install:force": "npm install --force",
"check:baileys": "npm ls @whiskeysockets/baileys",
"test": "echo "No tests configured"",
"docker:build": "docker build -t muzamil-xd ."
},
"keywords": [
"whatsapp-bot",
"muzamil-xd",
"redxbaileys",
"baileys"
],
"author": "MUZAMIL-XD",
"license": "ISC",
"dependencies": {
"@hapi/boom": "^10.0.1",
"@whiskeysockets/baileys": "github:AbdulRehman19721986/RedxBaileys",
"awesome-phonenumber": "^5.9.0",
"axios": "^1.8.4",
"@vitalets/google-translate-api": "^9.2.0",
"archiver": "^7.0.1",
"chalk": "^4.1.2",
"cheerio": "^1.0.0-rc.12",
"express": "^4.21.2",
"file-type": "^16.5.4",
"fluent-ffmpeg": "^2.1.3",
"form-data": "^4.0.1",
"fs-extra": "^11.2.0",
"human-readable": "^0.2.1",
"jimp": "^1.6.0",
"libphonenumber-js": "^1.11.18",
"moment-timezone": "^0.5.43",
"mumaker": "^2.0.0",
"node-cache": "^5.1.2",
"node-fetch": "^2.7.0",
"node-id3": "^0.2.3",
"node-webpmux": "^3.1.0",
"node-youtube-music": "^0.8.3",
"pino": "^8.21.0",
"ruhend-scraper": "^8.3.0",
"sharp": "^0.32.6",
"youtubedl-core": "^4.11.7",
"yt-search": "^2.12.1",
"ytdl-core": "^4.11.5"
},
"overrides": {
"jimp": "^1.6.0"
},
"engines": {
"node": ">=20.10.0"
},
"packageManager": "npm@10.8.2"
}
